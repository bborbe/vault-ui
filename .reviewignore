# Paths the PR reviewer skips — excluded from the MAX_ADDITIONS /
# MAX_CHANGED_FILES size gate and from the reviewer's context.

# dark-factory pipeline state (specs/prompts are human-gated by the
# dark-factory pipeline's own audit, not the PR reviewer)
prompts/
specs/

# counterfeiter-generated mocks — machine-written, so no reviewer reads them
# line by line. 50 of 58 sibling repos already skip these.
mocks/

# npm's resolved dependency tree — machine-written, reproducible from
# package.json, and it would otherwise dominate every frontend diff.
frontend/package-lock.json

# tygo-generated from pkg/api (make types) — same rule as the counterfeiter
# mocks above: generated, never hand-edited.
frontend/src/types.ts