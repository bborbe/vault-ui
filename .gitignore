# Local configuration (machine-specific, not committed)
config.yaml

# Build output
/build/
/bin/

# Frontend build output. The directory must exist for go:embed to compile, so
# its .gitkeep is committed and everything else is ignored.
/frontend/dist/*
!/frontend/dist/.gitkeep
/frontend/node_modules/

/CLAUDE.md
/.claude
/.mcp-auth-*
/.mcp-*
/.mcp.json
/.update-logs
/.dark-factory.lock
/.dark-factory.log
/prompts/log
/specs/log
/.dark-factory.daemon.out
