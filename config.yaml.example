# vault-ui looks for its config in this order:
#   1. ~/.config/vault-ui/config.yaml  (preferred — copy this file there)
#   2. ./config.yaml                    (legacy, repo-root fallback)
# Copy this example to ~/.config/vault-ui/config.yaml for new installs.
vault_cli_path: vault-cli  # optional, defaults to "vault-cli"
host: 127.0.0.1
port: 8000
# Cap on concurrent Claude sessions admitted via the Start button; excess clicks are refused with HTTP 429.
max_concurrent_sessions: 20
vaults:
  # List vaults vault-ui should manage.
  # claude_script is inherited automatically from vault-cli's registry — no need to repeat it here.
  # vault_name overrides the Obsidian URL name (optional, defaults to name.title()).
  personal:
  brogrammers:
    vault_name: Brogrammers  # optional, defaults to name.title()
  family:
